{
  "name": "@plateforme/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/main.js)",
    "dev:db": "tsx scripts/dev-db.ts",
    "create-superadmin": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/cli/create-superadmin.js",
    "test": "vitest run",
    "seed:demo": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/cli/seed-demo.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/platform-socket.io": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.9",
    "@plateforme/contracts": "0.1.0",
    "argon2": "0.45.2",
    "cloudinary": "2.11.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "mongoose": "8.24.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.9",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.4.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  }
}
