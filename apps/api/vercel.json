{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @plateforme/contracts && npm run build -w @plateforme/api",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "includeFiles": "dist/**", "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/api/internal/cron/orders", "schedule": "* * * * *" },
    { "path": "/api/internal/cron/ops", "schedule": "* * * * *" }
  ]
}
