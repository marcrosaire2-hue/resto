# Copier en .env puis renseigner. Ne jamais committer de vraies valeurs.
NODE_ENV=development
PORT=4000
# MongoDB DOIT tourner en replica set (transactions). En local : npm run dev:db
MONGODB_URI=mongodb://127.0.0.1:27017/plateforme?replicaSet=rs0
WEB_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
SESSION_TTL_HOURS=336
# true obligatoire en production (HTTPS)
COOKIE_SECURE=false
# Nombre de proxys de confiance devant l'API (1 derrière Caddy/Nginx)
TRUST_PROXY=0
THROTTLE_LIMIT_PER_MIN=120
THROTTLE_AUTH_LIMIT_PER_MIN=10
# Cloudinary (laisser vide tant que le compte n'est pas créé : les téléversements renverront 503)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_FOLDER_PREFIX=plateforme

# FedaPay (Mobile Money MTN / Moov). Sans clé, le paiement en ligne est masqué.
# FEDAPAY_ENV=sandbox            # sandbox | live
# FEDAPAY_SECRET_KEY=            # sk_sandbox_... ou sk_live_... (serveur uniquement)
# FEDAPAY_PUBLIC_KEY=
# FEDAPAY_WEBHOOK_SECRET=        # wh_... (obligatoire en production)

# Brevo (e-mails transactionnels : codes de vérification à 6 chiffres). Sans clé, l'inscription est impossible.
# BREVO_API_KEY=                 # clé restreinte aux « Emails transactionnels » (serveur uniquement)
# MAIL_FROM_EMAIL=               # expéditeur vérifié dans Brevo (idéalement noreply@votre-domaine)
# MAIL_FROM_NAME=                # nom affiché aux destinataires
